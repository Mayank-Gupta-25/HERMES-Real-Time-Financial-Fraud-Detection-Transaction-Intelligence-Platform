{
  "uid": "hermes-fraud-detection-metrics",
  "title": "HERMES Hybrid Fraud Engine & Scoring Telemetry",
  "tags": ["hermes", "fraud", "ml", "rules", "MOD-04", "MOD-08"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Fraud Scoring Latency (p50 / p95 / p99 ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(hermes_scoring_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "p50 scoring ms"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(hermes_scoring_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "p95 scoring ms"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(hermes_scoring_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "p99 scoring ms"
        }
      ]
    },
    {
      "id": 2,
      "title": "Hybrid Fraud Score Distribution by Risk Band & Decision",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(hermes_fraud_score_distribution_count[1m])) by (risk_band, decision)",
          "legendFormat": "{{risk_band}} -> {{decision}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active Unacknowledged Fraud Alerts by Severity",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(hermes_active_alerts_gauge) by (risk_band)",
          "legendFormat": "{{risk_band}}"
        }
      ]
    }
  ]
}
