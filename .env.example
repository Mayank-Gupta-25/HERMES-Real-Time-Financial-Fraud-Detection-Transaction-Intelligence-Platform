# Local development defaults. Replace the development credentials before deployment.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hermes_ops
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes_dev_pass

TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=hermes_metrics
TIMESCALE_USER=hermes
TIMESCALE_PASSWORD=hermes_dev_pass

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=hermes_minio
MINIO_ROOT_PASS=hermes_minio_pass
MINIO_BUCKET=hermes-archive

JWT_SECRET_KEY=hermes-dev-secret-key-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
FRAUD_SERVICE_URL=http://fraud-detection:8000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=hermes_grafana_dev

SIMULATOR_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SIMULATOR_KAFKA_TOPIC=hermes.transactions.raw
SIMULATOR_DEFAULT_TPS=1000
SIMULATOR_DEFAULT_FRAUD_RATE=0.05
SIMULATOR_NUM_CUSTOMERS=10000
SIMULATOR_NUM_MERCHANTS=5000
